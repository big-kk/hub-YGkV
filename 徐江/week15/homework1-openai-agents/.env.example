# 运行模式：mock = MockModel 本地模拟（无需 API Key）；real = DeepSeek 真实模型
EMOTION_LLM_MODE=mock

# real 模式必填：DeepSeek 开放平台 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务端口（可选）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
FRONTEND_PORT=8502
